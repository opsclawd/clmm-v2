        },
        "position_plans_lifecycle_kind_check": {
          "name": "position_plans_lifecycle_kind_check",
          "value": "\"position_plans\".\"lifecycle_kind\" IN ('requested', 'advisory-ready', 'exit-previewed', 'awaiting-signature', 'submitted', 'result-pending', 'reported', 'report-failed', 'conflict', 'superseded')"
