{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsclawd.dev/regime-engine/position-plan/v1/position-plan.schema.json",
  "title": "PositionPlan",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "planHash",
    "asOfUnixMs",
    "scope",
    "regime",
    "targets",
    "actions",
    "constraints",
    "nextRegimeState",
    "reasons",
    "telemetry",
    "marketData"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asOfUnixMs": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "required": ["kind", "positionId", "poolAddress", "symbol"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "position"
        },
        "positionId": {
          "type": "string",
          "minLength": 1
        },
        "poolAddress": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regime": {
      "type": "string",
      "enum": ["UP", "DOWN", "CHOP"]
    },
    "targets": {
      "$ref": "#/$defs/PlanTargets"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/PlanAction"
      }
    },
    "constraints": {
      "type": "object",
      "required": ["cooldownUntilUnixMs", "standDownUntilUnixMs", "notes"],
      "additionalProperties": false,
      "properties": {
        "cooldownUntilUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "standDownUntilUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nextRegimeState": {
      "$ref": "#/$defs/RegimeState"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["INFO", "WARN", "ERROR"]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "telemetry": {
      "$ref": "#/$defs/PlanTelemetry"
    },
    "marketData": {
      "$ref": "#/$defs/PlanMarketData"
    }
  },
  "$defs": {
    "PlanTargets": {
      "type": "object",
      "required": ["solBps", "usdcBps", "allowClmm"],
      "additionalProperties": false,
      "properties": {
        "solBps": {
          "type": "number"
        },
        "usdcBps": {
          "type": "number"
        },
        "allowClmm": {
          "type": "boolean"
        }
      }
    },
    "RegimeState": {
      "type": "object",
      "required": ["current", "barsInRegime", "pending", "pendingBars"],
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "string",
          "enum": ["UP", "DOWN", "CHOP"]
        },
        "barsInRegime": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["UP", "DOWN", "CHOP"]
            },
            {
              "type": "null"
            }
          ]
        },
        "pendingBars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PlanTelemetry": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }]
      }
    },
    "PlanMarketData": {
      "type": "object",
      "required": [
        "source",
        "network",
        "poolAddress",
        "requestedTimeframe",
        "sourceTimeframe",
        "candleCount",
        "sourceCandleCount",
        "freshness"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        },
        "poolAddress": {
          "type": "string",
          "minLength": 1
        },
        "requestedTimeframe": {
          "type": "string",
          "enum": ["15m", "1h"]
        },
        "sourceTimeframe": {
          "type": "string"
        },
        "candleCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCandleCount": {
          "type": "integer",
          "minimum": 0
        },
        "freshness": {
          "$ref": "#/$defs/RegimeCurrentFreshness"
        },
        "derivedTimeframe": {
          "type": "string"
        },
        "aggregationVersion": {
          "type": "string"
        }
      }
    },
    "RegimeCurrentFreshness": {
      "type": "object",
      "required": [
        "generatedAtIso",
        "lastCandleOpenUnixMs",
        "lastCandleOpenIso",
        "lastCandleCloseUnixMs",
        "lastCandleCloseIso",
        "ageSeconds",
        "softStale",
        "hardStale",
        "softStaleSeconds",
        "hardStaleSeconds"
      ],
      "additionalProperties": false,
      "properties": {
        "generatedAtIso": {
          "type": "string"
        },
        "lastCandleOpenUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "lastCandleOpenIso": {
          "type": "string"
        },
        "lastCandleCloseUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "lastCandleCloseIso": {
          "type": "string"
        },
        "ageSeconds": {
          "type": "number"
        },
        "softStale": {
          "type": "boolean"
        },
        "hardStale": {
          "type": "boolean"
        },
        "softStaleSeconds": {
          "type": "number"
        },
        "hardStaleSeconds": {
          "type": "number"
        }
      }
    },
    "PlanAction": {
      "type": "object",
      "required": ["type", "reasonCode"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["HOLD", "STAND_DOWN", "REQUEST_EXIT_CLMM"]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "exitIntent": {
          "$ref": "#/$defs/PlanExitIntent"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "REQUEST_EXIT_CLMM" }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "exitIntent": { "$ref": "#/$defs/PlanExitIntent" }
            },
            "required": ["exitIntent"]
          }
        }
      ]
    },
    "PlanExitIntent": {
      "type": "object",
      "required": ["posture"],
      "additionalProperties": false,
      "properties": {
        "posture": {
          "type": "string",
          "enum": ["ExitToUSDC", "ExitToSOL"]
        }
      }
    }
  }
}
